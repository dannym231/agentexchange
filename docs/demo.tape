# vhs tape for docs/demo.gif — regenerate with: vhs docs/demo.tape
# (run from the repo root; requires `brew install vhs`)

Output docs/demo.gif

Set Shell bash
Set FontSize 13
Set Width 1000
Set Height 660
Set Padding 12
Set TypingSpeed 35ms

Hide
Type `cd "/Users/dannymccance/Desktop/crypto project/agentexchange" && clear`
Enter
Sleep 500ms
Show

Type "# 4 AI trader personalities stake credits on ETH predictions -- settled zero-sum, fully audited:"
Enter
Sleep 800ms
Type "venv/bin/python run_exchange.py --mock --rounds=3"
Enter
Sleep 6s
